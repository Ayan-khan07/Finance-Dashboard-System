# Copy to .env (never commit it) and load it into your shell before running:
#   set -a && source .env && set +a && mvn spring-boot:run
# (IntelliJ / VS Code: paste these into the run configuration's environment variables instead.)

# --- Neon (PostgreSQL) -------------------------------------------------------
# Neon shows:  postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# JDBC needs:  jdbc:postgresql://HOST/DBNAME?sslmode=require   (user/password go in separate vars)
DB_URL=jdbc:postgresql://ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=change-me

# --- Security ------------------------------------------------------------------
# Generate with:  openssl rand -base64 48
JWT_SECRET=PASTE_OUTPUT_OF_openssl_rand_-base64_48_HERE

# --- AI -------------------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=change-me

# --- First ADMIN (used once, only when the users table is empty) ------------------
# Remove BOOTSTRAP_ADMIN_PASSWORD after the first successful start.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Str0ng-Pass!

# --- Optional ---------------------------------------------------------------------
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_READ_TIMEOUT_MS=15000
# DB_POOL_MAX_SIZE=5
# JWT_EXPIRATION_MINUTES=60
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# DDL_AUTO=update
# SWAGGER_ENABLED=true
